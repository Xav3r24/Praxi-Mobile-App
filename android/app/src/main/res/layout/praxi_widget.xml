<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_0">

    <ImageView
        android:id="@+id/widget_pet"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/praxi_widget_pet"
        android:contentDescription="Praxi"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PRAXI · Now"
            android:textColor="#9db8ff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Hi Xavier."
            android:textColor="#eef1f8"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/widget_action_background"
            android:text="Read Rhapsody"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
